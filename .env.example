# ============================================
# 숏폼 (WingsAIStudioShotForm/shopping) 전용
# ============================================
SHOPPING_GOOGLE_CLOUD_PROJECT_ID=project-493a61f2-cda9-4bb2-823
SHOPPING_GOOGLE_CLOUD_STORAGE_BUCKET=wings_short

# 서비스 계정: 아래 둘 중 하나만 설정
# 방법 1) 로컬 - JSON 키 파일 경로
SHOPPING_GOOGLE_APPLICATION_CREDENTIALS=

# 방법 2) Vercel 등 배포 - JSON 전체 내용을 한 줄로 붙여넣기
# SHOPPING_GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}

# 숏폼 전용 Cloud Run (영상 렌더·YouTube/TikTok URL 해석) URL - 로컬 테스트/배포 시 필수 (끝 / 없이)
SHOPPING_CLOUD_RUN_RENDER_URL=
# (선택) ShotForm 전용 alias — 미설정 시 SHOPPING_CLOUD_RUN_RENDER_URL 사용
SHOTFORM_CLOUD_RUN_RENDER_URL=
SHOPPING_CLOUD_RUN_AUTH_TOKEN=

# 제품 검색 — SerpApi (Google Lens / Yandex 이미지 검색 링크 생성). 로컬은 .env.local 권장
SERPAPI_KEY=

# product-search: lite(기본, ~₩10/회) | full(Serp+Apify+LLM rerank)
PRODUCT_SEARCH_MODE=lite

# MVP 테스트(Apify) — TikTok·抖音·小红书·YouTube 재가공 Actor
APIFY_TOKEN=
# (선택) YouTube 재가공 Actor — 기본 easyapi/youtube-video-and-mp3-downloader
APIFY_YOUTUBE_ACTOR=

# Vmake AI — 중국어 하드 자막 제거 (vmake.ai/developers → Skill WAPI)
# MT_AK / MT_SK 또는 아래 alias 사용
MT_AK=
MT_SK=
VMAKE_API_KEY=
VMAKE_SECRET_ACCESS_KEY=
# 영상 자막/워터마크 제거 preset (기본 videoscreenclear)
# VMAKE_VIDEO_TASK_PRESET=videoscreenclear

# 네이버 Open API — 데이터랩 쇼핑인사이트 (실시간 쇼핑순위)
# https://developers.naver.com/apps — 검색어 트렌드·쇼핑인사이트 API 사용 설정 필요
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# (선택) 데이터랩 전용 alias — 미설정 시 NAVER_CLIENT_ID/SECRET 사용
NAVER_DATALAB_CLIENT_ID=
NAVER_DATALAB_CLIENT_SECRET=

# 로컬 ffmpeg 렌더 (npm run dev) — 기본 작업 폴더. UI에서도 변경 가능
# SHOTFORM_LOCAL_WORK_DIR=C:\Users\이름\ShotForm\auto-edit
# 배포 사이트 + 로컬 폴더 렌더: PC에서 최초 1회 npm run shotform:install-agent
# SHOTFORM_LOCAL_AGENT_PORT=3847
